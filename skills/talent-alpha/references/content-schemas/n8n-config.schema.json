{
  "title": "Talent Alpha n8n Config node",
  "type": "object",
  "required": [
    "targetSectors",
    "companyProfile",
    "openRole"
  ],
  "additionalProperties": false,
  "properties": {
    "targetSectors": {
      "type": "string"
    },
    "companyProfile": {
      "type": "string"
    },
    "openRole": {
      "type": "object",
      "required": [
        "id",
        "title",
        "functions",
        "location"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "location": {
          "type": "string"
        }
      }
    },
    "author": {
      "type": "string"
    },
    "companyName": {
      "type": "string"
    },
    "companyFacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        }
      }
    },
    "maxShown": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "includeFundingDistress": {
      "type": "boolean"
    },
    "stateNamespace": {
      "type": "string"
    },
    "stateFile": {
      "type": "string"
    },
    "sourcingCriteria": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seniority": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workArrangement": {
          "type": "string",
          "enum": [
            "",
            "onsite",
            "hybrid",
            "remote"
          ]
        },
        "eligibleLocations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "eventTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "layoff",
              "shutdown",
              "funding_distress"
            ]
          }
        },
        "priorityTriggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludeCompanies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
